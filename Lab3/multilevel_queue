#include <stdio.h>

int main() {
    int n, i;
    int at[20], bt[20], ct[20], wt[20], tat[20], rt[20], type[20];
    int completed = 0, time = 0;
    float avg_wt = 0, avg_tat = 0;

    printf("Enter number of processes: ");
    scanf("%d", &n);

    for(i = 0; i < n; i++) {
        printf("\nProcess %d\n", i + 1);

        printf("Enter Arrival Time: ");
        scanf("%d", &at[i]);

        printf("Enter Burst Time: ");
        scanf("%d", &bt[i]);

        printf("Enter Type (0 = System, 1 = User): ");
        scanf("%d", &type[i]);

        rt[i] = bt[i];
    }

    while(completed < n) {

        int idx = -1;

        for(i = 0; i < n; i++) {
            if(at[i] <= time && rt[i] > 0 && type[i] == 0) {
                if(idx == -1 || at[i] < at[idx])
                    idx = i;
            }
        }

        if(idx == -1) {
            for(i = 0; i < n; i++) {
                if(at[i] <= time && rt[i] > 0 && type[i] == 1) {
                    if(idx == -1 || at[i] < at[idx])
                        idx = i;
                }
            }
        }

        if(idx == -1) {
            time++;
            continue;
        }

        rt[idx]--;
        time++;

        if(rt[idx] == 0) {
            ct[idx] = time;
            tat[idx] = ct[idx] - at[idx];
            wt[idx] = tat[idx] - bt[idx];

            completed++;
        }
    }

    printf("\nP\tType\tAT\tBT\tCT\tWT\tTAT\n");

    for(i = 0; i < n; i++) {

        if(type[i] == 0)
            printf("P%d\tSystem\t%d\t%d\t%d\t%d\t%d\n",
                   i + 1, at[i], bt[i], ct[i], wt[i], tat[i]);
        else
            printf("P%d\tUser\t%d\t%d\t%d\t%d\t%d\n",
                   i + 1, at[i], bt[i], ct[i], wt[i], tat[i]);

        avg_wt += wt[i];
        avg_tat += tat[i];
    }

    printf("\nAverage Waiting Time = %.2f", avg_wt / n);
    printf("\nAverage Turnaround Time = %.2f\n", avg_tat / n);

    return 0;
}
